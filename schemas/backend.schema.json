{
  "$comment": "SPDX-License-Identifier: GPL-3.0-only",
  "$id": "https://raw.githubusercontent.com/jorge-menjivar/super-stt/main/schemas/backend.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "backend": {
            "properties": {
              "kind": {
                "const": "wasm"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "backend",
          "assets"
        ]
      },
      "then": {
        "properties": {
          "assets": {
            "required": [
              "wasm"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "backend": {
            "properties": {
              "kind": {
                "const": "subprocess"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "backend",
          "assets"
        ]
      },
      "then": {
        "properties": {
          "assets": {
            "properties": {
              "subprocess": {
                "minItems": 1
              }
            },
            "required": [
              "subprocess"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "assets"
        ]
      },
      "then": {
        "properties": {
          "backend": {
            "required": [
              "license"
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "Accel": {
      "description": "Acceleration backend of a subprocess build.",
      "enum": [
        "cpu",
        "cuda",
        "metal",
        "rocm",
        "vulkan"
      ],
      "type": "string"
    },
    "Assets": {
      "additionalProperties": false,
      "description": "`[assets]` — binary artifacts a release publishes, so the registry indexer\nand the daemon's installer can find them without guessing.",
      "properties": {
        "subprocess": {
          "description": "One entry per built subprocess variant. Required (non-empty) for\nregistry publication when `kind = \"subprocess\"`.",
          "items": {
            "$ref": "#/definitions/SubprocessAsset"
          },
          "type": "array"
        },
        "wasm": {
          "default": null,
          "description": "Filename of the wasm component on the GitHub release. Required for\nregistry publication when `kind = \"wasm\"`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "BackendMeta": {
      "additionalProperties": false,
      "description": "`[backend]` — identity and packaging.",
      "properties": {
        "contract": {
          "allOf": [
            {
              "$ref": "#/definitions/Contract"
            }
          ],
          "description": "The backend-protocol contract version implemented."
        },
        "description": {
          "default": null,
          "description": "One-line summary shown in the registry/Browse listing.",
          "type": [
            "string",
            "null"
          ]
        },
        "entrypoint": {
          "description": "Path, relative to the backend directory, to the executable\n(`subprocess`) or the `.wasm` component (`wasm`). May be a nested\nrelative path such as `bin/launcher` for multi-file bundles.\nMust not escape the backend directory: no absolute paths, no `..`\ncomponents, no backslashes, no embedded NUL.",
          "type": "string"
        },
        "kind": {
          "allOf": [
            {
              "$ref": "#/definitions/Kind"
            }
          ],
          "description": "Selects the transport."
        },
        "license": {
          "default": null,
          "description": "License of the backend: a current SPDX identifier that is OSI-approved\nor FSF Free/Libre (e.g. `Apache-2.0`, `MIT`, `GPL-3.0-only`), or the\nliteral `other` for a license outside that set. Optional for local\ninstalls; required for registry publication, where the indexer rejects\na manifest that omits the field or declares an unrecognized value.",
          "enum": [
            "0BSD",
            "AAL",
            "AFL-1.1",
            "AFL-1.2",
            "AFL-2.0",
            "AFL-2.1",
            "AFL-3.0",
            "AGPL-3.0-only",
            "AGPL-3.0-or-later",
            "ALGLIB-Documentation",
            "APL-1.0",
            "APSL-1.0",
            "APSL-1.1",
            "APSL-1.2",
            "APSL-2.0",
            "Apache-1.0",
            "Apache-1.1",
            "Apache-2.0",
            "Artistic-1.0",
            "Artistic-1.0-Perl",
            "Artistic-1.0-cl8",
            "Artistic-2.0",
            "BSD-1-Clause",
            "BSD-2-Clause",
            "BSD-2-Clause-Patent",
            "BSD-3-Clause",
            "BSD-3-Clause-Clear",
            "BSD-3-Clause-LBNL",
            "BSD-3-Clause-Open-MPI",
            "BSD-4-Clause",
            "BSL-1.0",
            "BitTorrent-1.1",
            "BlueOak-1.0.0",
            "CAL-1.0",
            "CAL-1.0-Combined-Work-Exception",
            "CATOSL-1.1",
            "CC-BY-4.0",
            "CC-BY-SA-4.0",
            "CC0-1.0",
            "CDDL-1.0",
            "CECILL-2.0",
            "CECILL-2.1",
            "CECILL-B",
            "CECILL-C",
            "CERN-OHL-P-2.0",
            "CERN-OHL-S-2.0",
            "CERN-OHL-W-2.0",
            "CNRI-Python",
            "CPAL-1.0",
            "CPL-1.0",
            "CUA-OPL-1.0",
            "ClArtistic",
            "Condor-1.1",
            "ECL-1.0",
            "ECL-2.0",
            "EFL-1.0",
            "EFL-2.0",
            "EPL-1.0",
            "EPL-2.0",
            "EUDatagrid",
            "EUPL-1.1",
            "EUPL-1.2",
            "Entessa",
            "FSFAP",
            "FTL",
            "Fair",
            "Frameworx-1.0",
            "GFDL-1.1-only",
            "GFDL-1.1-or-later",
            "GFDL-1.2-only",
            "GFDL-1.2-or-later",
            "GFDL-1.3-only",
            "GFDL-1.3-or-later",
            "GPL-2.0-only",
            "GPL-2.0-or-later",
            "GPL-3.0-only",
            "GPL-3.0-or-later",
            "HPND",
            "ICU",
            "IJG",
            "IPA",
            "IPL-1.0",
            "ISC",
            "Imlib2",
            "Intel",
            "Jam",
            "LGPL-2.0-only",
            "LGPL-2.0-or-later",
            "LGPL-2.1-only",
            "LGPL-2.1-or-later",
            "LGPL-3.0-only",
            "LGPL-3.0-or-later",
            "LPL-1.0",
            "LPL-1.02",
            "LPPL-1.2",
            "LPPL-1.3a",
            "LPPL-1.3c",
            "LiLiQ-P-1.1",
            "LiLiQ-R-1.1",
            "LiLiQ-Rplus-1.1",
            "MIT",
            "MIT-0",
            "MIT-Modern-Variant",
            "MPL-1.0",
            "MPL-1.1",
            "MPL-2.0",
            "MPL-2.0-no-copyleft-exception",
            "MS-PL",
            "MS-RL",
            "MirOS",
            "Motosoto",
            "MulanPSL-2.0",
            "Multics",
            "NASA-1.3",
            "NCSA",
            "NGPL",
            "NOSL",
            "NPL-1.0",
            "NPL-1.1",
            "NPOSL-3.0",
            "NTP",
            "Naumen",
            "Nokia",
            "OCLC-2.0",
            "ODbL-1.0",
            "OFL-1.0",
            "OFL-1.1",
            "OFL-1.1-RFN",
            "OFL-1.1-no-RFN",
            "OGTSL",
            "OLDAP-2.3",
            "OLDAP-2.7",
            "OLDAP-2.8",
            "OLFL-1.3",
            "OSC-1.0",
            "OSET-PL-2.1",
            "OSL-1.0",
            "OSL-1.1",
            "OSL-2.0",
            "OSL-2.1",
            "OSL-3.0",
            "OpenSSL",
            "PHP-3.0",
            "PHP-3.01",
            "PostgreSQL",
            "Python-2.0",
            "QPL-1.0",
            "RPL-1.1",
            "RPL-1.5",
            "RPSL-1.0",
            "RSCPL",
            "Ruby",
            "SGI-B-2.0",
            "SISSL",
            "SMLNJ",
            "SPL-1.0",
            "SimPL-2.0",
            "Sleepycat",
            "UCL-1.0",
            "UPL-1.0",
            "Unicode-3.0",
            "Unicode-DFS-2016",
            "Unlicense",
            "VSL-1.0",
            "Vim",
            "W3C",
            "W3C-20150513",
            "WTFPL",
            "Watcom-1.0",
            "WordNet",
            "X11",
            "XFree86-1.1",
            "Xnet",
            "YPL-1.1",
            "ZPL-2.0",
            "ZPL-2.1",
            "Zend-2.0",
            "Zimbra-1.3",
            "Zlib",
            "gnuplot",
            "iMatix",
            "xinetd",
            "other"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Human-readable display name.",
          "type": "string"
        },
        "source": {
          "description": "Canonical repository id, e.g. `github.com/<owner>/<repo>`. Becomes the\n`source` of every model this backend provides and must be unique\nacross installed backends. For a monorepo, namespace it under the repo\n(e.g. `github.com/<owner>/<repo>/openai`).",
          "type": "string"
        },
        "version": {
          "description": "Backend version (semver). Must match the release tag's version when\npublished through the registry.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "name",
        "version",
        "kind",
        "entrypoint",
        "contract"
      ],
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "description": "`[capabilities]` — transport extensions beyond the base `/v1` contract.",
      "properties": {
        "websocket": {
          "default": false,
          "description": "Opt into the realtime WebSocket import/export. wasm-only — a\n`subprocess` backend declaring this is rejected at discovery.\nRequired for any model with `realtime = true`. Default `false`.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Contract": {
      "description": "Backend-protocol contract version.",
      "oneOf": [
        {
          "const": "v1",
          "description": "The v1 contract (`docs/protocol/backend/contract.md`).",
          "type": "string"
        }
      ]
    },
    "Device": {
      "description": "A device a model can be loaded onto.",
      "oneOf": [
        {
          "enum": [
            "cpu",
            "cuda",
            "metal"
          ],
          "type": "string"
        },
        {
          "const": "none",
          "description": "Sentinel for remote/online models with no local compute; must be the\nonly entry when present.",
          "type": "string"
        }
      ]
    },
    "FileSource": {
      "description": "Source of a `[[models.files]]` download group.",
      "oneOf": [
        {
          "const": "huggingface",
          "description": "Fetch `files` from the Hugging Face repo `repo` at `revision`.",
          "type": "string"
        },
        {
          "const": "url",
          "description": "Fetch a single file from `url`.",
          "type": "string"
        }
      ]
    },
    "FilesSpec": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "required": [
              "repo",
              "files"
            ]
          },
          "if": {
            "properties": {
              "source": {
                "const": "url"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ],
      "description": "One `[[models.files]]` download group.",
      "properties": {
        "dest": {
          "description": "Directory, relative to the backend dir, to place the files in\n(e.g. `models/whisper-tiny`).",
          "type": "string"
        },
        "files": {
          "default": [],
          "description": "Filenames to fetch from the repo. Required when\n`source = \"huggingface\"`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repo": {
          "default": "",
          "description": "Hugging Face repo id, e.g. `openai/whisper-tiny`. Required when\n`source = \"huggingface\"`.",
          "type": "string"
        },
        "revision": {
          "default": "main",
          "description": "Hugging Face revision. Default `main`.",
          "type": "string"
        },
        "sha256": {
          "default": null,
          "description": "Expected SHA-256 of the downloaded file, for integrity verification.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "allOf": [
            {
              "$ref": "#/definitions/FileSource"
            }
          ],
          "default": "huggingface",
          "description": "Where the files come from. Default `huggingface`."
        },
        "url": {
          "default": null,
          "description": "Direct download URL for a single file. Required when\n`source = \"url\"`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "dest"
      ],
      "type": "object"
    },
    "Kind": {
      "description": "Transport a backend uses: a wasm32 component or a native executable.",
      "oneOf": [
        {
          "const": "wasm",
          "description": "A `wasm32` component loaded in the daemon's WASM host.",
          "type": "string"
        },
        {
          "const": "subprocess",
          "description": "A native executable run in the daemon's subprocess sandbox.",
          "type": "string"
        }
      ]
    },
    "ModelEntry": {
      "additionalProperties": false,
      "description": "One `[[models]]` entry. Each model is identified on the wire by\n`(name, provider, source)`, where `source` is `[backend].source`.",
      "properties": {
        "estimated_vram_bytes": {
          "default": 0,
          "description": "Conservative GPU memory estimate in bytes. Default `0`; use `0` for\ncloud models.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "description": "Files the model needs, provisioned into `dest` before\n`POST /v1/load`. Cloud models declare none.",
          "items": {
            "$ref": "#/definitions/FilesSpec"
          },
          "type": "array"
        },
        "multilingual": {
          "default": true,
          "description": "Whether the model accepts more than one language. Default `true`.\nWhen `false`, `supported_languages` must be exactly\n`[primary_language]`.",
          "type": "boolean"
        },
        "name": {
          "description": "Wire model name.",
          "type": "string"
        },
        "primary_language": {
          "description": "Default language code (e.g. `en`); used when `language` is omitted.\nMust appear in `supported_languages`.",
          "type": "string"
        },
        "processing_interval_ms": {
          "default": null,
          "description": "Suggested minimum interval between streaming passes, in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "provider": {
          "allOf": [
            {
              "$ref": "#/definitions/Provider"
            }
          ],
          "description": "Engine that serves the model."
        },
        "realtime": {
          "default": false,
          "description": "When `true`, the model is driven over the consumer WebSocket endpoint\nrather than batch `POST /v1/transcribe`. Requires\n`[capabilities] websocket = true`. Default `false`.",
          "type": "boolean"
        },
        "supported_devices": {
          "description": "Devices the model can be loaded onto. The sentinel `none` (remote /\nonline model with no local compute) must be the only entry when\npresent. Non-empty.",
          "items": {
            "$ref": "#/definitions/Device"
          },
          "minItems": 1,
          "type": "array"
        },
        "supported_languages": {
          "description": "Language codes the model accepts; must include `primary_language`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "provider",
        "primary_language",
        "supported_languages",
        "supported_devices"
      ],
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "description": "`[network]` — outbound network policy.",
      "properties": {
        "allowed_hosts": {
          "default": [],
          "description": "Host or `host:port` egress allowlist. Empty or absent means no\nnetwork. Honored for `wasm` backends; must be empty for `subprocess`\nbackends (the transport provides no network).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Opt": {
      "additionalProperties": false,
      "description": "One `[[options]]` declaration — non-secret configuration the backend reads\nas an `x-stt-option-<name>` request header.",
      "properties": {
        "default": {
          "anyOf": [
            {
              "$ref": "#/definitions/OptionDefault"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Value used when the user sets none. Should match `type`."
        },
        "description": {
          "description": "Help text shown beside the input in the settings UI.",
          "type": "string"
        },
        "label": {
          "default": null,
          "description": "Human-readable label shown in the settings UI. Falls back to `name`\nwhen absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "`snake_case` identifier the backend reads the value by. Unique within\nthe table.",
          "type": "string"
        },
        "required": {
          "default": false,
          "description": "Whether a value must be set before the backend can load. Default\n`false`.",
          "type": "boolean"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/definitions/OptionType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Drives the input the UI renders. Default `string`."
        }
      },
      "required": [
        "name",
        "description"
      ],
      "type": "object"
    },
    "OptionDefault": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "int64",
          "type": "integer"
        },
        {
          "type": "boolean"
        }
      ],
      "description": "An option's default value; matches the option's declared `type`."
    },
    "OptionType": {
      "description": "The input type of an option.",
      "enum": [
        "string",
        "integer",
        "bool"
      ],
      "type": "string"
    },
    "Provider": {
      "description": "Engine that serves the model. The wire form is snake_case.",
      "enum": [
        "local_whisper",
        "local_voxtral",
        "local_qwen3_asr",
        "openai",
        "mistral",
        "deepgram"
      ],
      "type": "string"
    },
    "Secret": {
      "additionalProperties": false,
      "description": "One `[[secrets]]` declaration — an encrypted credential the backend reads\nas an `x-stt-secret-<name>` request header.",
      "properties": {
        "description": {
          "description": "Help text shown beside the input in the settings UI.",
          "type": "string"
        },
        "label": {
          "default": null,
          "description": "Human-readable label shown in the settings UI. Falls back to `name`\nwhen absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "`snake_case` identifier the backend reads the value by. Unique within\nthe table.",
          "type": "string"
        },
        "required": {
          "default": false,
          "description": "Whether a value must be set before the backend can load. Default\n`false`.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "type": "object"
    },
    "SubprocessAsset": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "cuda_major": false,
              "cuda_sm": false,
              "cudnn": {
                "const": false
              }
            }
          },
          "if": {
            "properties": {
              "accel": {
                "const": "cuda"
              }
            },
            "required": [
              "accel"
            ]
          },
          "then": {
            "required": [
              "cuda_major"
            ]
          }
        }
      ],
      "description": "One `[[assets.subprocess]]` build variant.",
      "properties": {
        "accel": {
          "allOf": [
            {
              "$ref": "#/definitions/Accel"
            }
          ],
          "description": "Acceleration backend the build targets."
        },
        "cuda_major": {
          "default": null,
          "description": "CUDA major version this build targets. Required when\n`accel = \"cuda\"`, forbidden otherwise.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cuda_sm": {
          "default": null,
          "description": "Compute capability (e.g. `75`, `86`, `90`, `120`). Omit to match any\ncompute capability — use for multi-architecture framework builds\n(e.g. a `PyTorch` wheel). An exact-SM asset is preferred over a\nwildcard when both match. Forbidden when `accel != \"cuda\"`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cudnn": {
          "default": false,
          "description": "Whether this build links cuDNN. Allowed only when `accel = \"cuda\"`.\nDefault `false`.",
          "type": "boolean"
        },
        "file": {
          "description": "Filename on the GitHub release (`.tar.gz`). The archive must contain\n`bin/<entrypoint>`.",
          "type": "string"
        },
        "target": {
          "description": "Rust target triple, e.g. `x86_64-unknown-linux-gnu`. Tier-1/2 only;\nthe indexer rejects unknown triples.",
          "type": "string"
        }
      },
      "required": [
        "file",
        "target",
        "accel"
      ],
      "type": "object"
    }
  },
  "description": "A backend's `backend.toml`: identity, packaging, network policy,\nsecrets/options, and the models it provides.",
  "properties": {
    "assets": {
      "allOf": [
        {
          "$ref": "#/definitions/Assets"
        }
      ],
      "description": "Binary artifacts a release publishes. Optional for locally installed\nbackends; required (per `kind`) for registry publication."
    },
    "backend": {
      "allOf": [
        {
          "$ref": "#/definitions/BackendMeta"
        }
      ],
      "description": "Backend identity and packaging."
    },
    "capabilities": {
      "allOf": [
        {
          "$ref": "#/definitions/Capabilities"
        }
      ],
      "description": "Optional feature flags that unlock transport extensions."
    },
    "models": {
      "description": "One entry per model the backend provides.",
      "items": {
        "$ref": "#/definitions/ModelEntry"
      },
      "type": "array"
    },
    "network": {
      "allOf": [
        {
          "$ref": "#/definitions/Network"
        }
      ],
      "description": "Outbound network the backend is permitted to reach."
    },
    "options": {
