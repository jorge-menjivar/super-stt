<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The global shortcut: `stt hotkey`, from login.

  This is the macOS stand-in for a desktop environment's custom shortcut. On
  Linux the DE runs `stt record --write` when the key is pressed; macOS has no
  such place to bind a key to a command, so this keeps a small client alive
  that owns the key and does the same thing on each press. See
  super-stt-cli/src/hotkey.rs.

  Its own agent rather than a thread in the daemon: the daemon stays headless
  and knows nothing about input, and the shortcut can be stopped, rebound or
  left uninstalled without touching transcription.

  It needs no Accessibility or Input Monitoring grant — ordinary shortcuts are
  registered through Carbon's RegisterEventHotKey, which asks for neither.

  Like the daemon's agent it ships inside the app bundle and is registered
  with SMAppService; see super-stt-daemon/launchd/ for what that means for
  this file. One placeholder is substituted by `just bundle-macos` before the
  bundle is signed:

    __BINDING__   the shortcut: $SUPER_STT_HOTKEY, else ctrl+alt+space. The
                  recipe validates it with the listener's own check mode
                  first, since a binding the listener rejects would otherwise
                  be restarted every ThrottleInterval, failing the same way
                  each time.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.menjivar.super-stt.hotkey</string>

    <!--
      A copy of the CLI in Contents/Helpers, not the one in Contents/MacOS.
      The listener runs an AppKit event loop, and any process that does so
      from Contents/MacOS registers with macOS as the app itself: opening
      Super STT then activates this invisible listener instead of launching
      the settings app. From Contents/Helpers it is a process of its own.
      The daemon trusts first-party binaries there as it does beside itself;
      see `bundle_helpers_dir` in super-stt-daemon's auth/consent.rs.
    -->
    <key>BundleProgram</key>
    <string>Contents/Helpers/super-stt-cli</string>

    <!--
      `super-stt-cli/src/main.rs` parses these in a test
      (`hotkey_launch_agent_arguments_parse`), so a rename in the CLI cannot
      leave this agent passing arguments clap rejects.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>super-stt-cli</string>
        <string>hotkey</string>
        <string>--key</string>
        <string>__BINDING__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!--
      Restarted if it exits. The daemon being down is not a reason to exit: a
      press that cannot reach it is logged, and the next press tries again.
    -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- A press should start the recording now, not when App Nap gets round to it. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
        <!-- See the daemon's agent for why this is not StandardErrorPath. -->
        <key>SUPER_STT_LOG_FILE</key>
        <string>Library/Logs/super-stt/hotkey.log</string>
    </dict>
</dict>
</plist>
