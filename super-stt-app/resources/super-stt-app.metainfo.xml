<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ai.menjivar.SuperSTT</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Super STT</name>
  <summary>High-performance speech-to-text application</summary>
  <description>
    <p>
      Super STT types what you say into whatever app is focused. Bind a
      shortcut, speak, and the text appears where you are working.
    </p>
    <p>
      A background daemon installs speech models from a library of local
      and cloud backends and keeps one loaded, so transcription starts
      right away. This app is where you pick a backend, load a model, and
      configure the daemon.
    </p>
  </description>
  <developer id="ai.menjivar">
    <name>Jorge Menjivar</name>
  </developer>
  <icon type="stock">super-stt-app</icon>
  <launchable type="desktop-id">super-stt-app.desktop</launchable>
  <url type="homepage">https://github.com/jorge-menjivar/super-stt</url>
  <url type="bugtracker">https://github.com/jorge-menjivar/super-stt/issues</url>
  <url type="vcs-browser">https://github.com/jorge-menjivar/super-stt</url>
  <screenshots>
    <screenshot type="default">
      <caption>Pick a backend and load a speech model</caption>
      <image>https://raw.githubusercontent.com/jorge-menjivar/super-stt/main/.github/assets/screenshots/app-1.png</image>
    </screenshot>
    <screenshot>
      <caption>Choose which model runs, and whether it runs on CPU or GPU</caption>
      <image>https://raw.githubusercontent.com/jorge-menjivar/super-stt/main/.github/assets/screenshots/app-4.png</image>
    </screenshot>
    <screenshot>
      <caption>Browse the catalog of available backends</caption>
      <image>https://raw.githubusercontent.com/jorge-menjivar/super-stt/main/.github/assets/screenshots/app-7.png</image>
    </screenshot>
    <screenshot>
      <caption>Tune audio feedback and recording behavior</caption>
      <image>https://raw.githubusercontent.com/jorge-menjivar/super-stt/main/.github/assets/screenshots/app-8.png</image>
    </screenshot>
  </screenshots>
  <provides>
